# =====================================================================
# Elora (Digital Shop T.M) — Frontend Environment Template (Vite)
# Only public VITE_* variables belong here — NEVER put secrets here!
# =====================================================================

# Live Render Backend URL (set in .env.production before `firebase deploy --only hosting`)
# Leave blank during local dev when using the Vite proxy below
VITE_API_URL=

# Localhost Dev Proxy Target when running `frontend` separately from `Backend`
VITE_DEV_API_TARGET=http://localhost:5000

# Optional comma-separated Super Admin emails for UI Admin Panel visibility
VITE_ADMIN_EMAILS=
