# =====================================================================
# Digital Shop T.M — Standalone Frontend Environment Template (frontend)
# Only public VITE_* client variables belong here — NEVER put backend secrets here!
# =====================================================================

# Live Backend API Base URL (e.g. https://your-backend.onrender.com)
# Leave blank when running behind the same-origin proxy on localhost
VITE_API_BASE_URL=

# Localhost Dev Proxy Target when running `frontend` separately from `Backend`
VITE_DEV_API_TARGET=http://localhost:5000

# Optional comma-separated Super Admin emails for UI Admin Panel visibility
VITE_ADMIN_EMAILS=kowshikkantidas@gmail.com
